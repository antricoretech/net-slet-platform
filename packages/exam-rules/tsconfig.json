{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node", "lib": ["ES2022", "DOM"],
    "outDir": "./dist", "rootDir": "./src", "declaration": true,
    "skipLibCheck": true, "strict": true, "esModuleInterop": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
