# LOCAL DEV ONLY; match root .env Docker credentials
DATABASE_URL=postgresql://netslet:local_dev_change_me@127.0.0.1:5432/netslet_dev?schema=public
REDIS_URL=redis://127.0.0.1:6379
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Comma-separated credentialed browser origins for deployed environments.
WEB_ORIGINS=http://localhost:3000
# Runtime safety contract. Replace every local value before staging/production.
APP_ENV=development
SECURE_COOKIES=false
TRUSTED_PROXY=false
SESSION_SECRET=local_development_only_replace_me
# Production requires a non-console provider and these fields.
# EMAIL_PROVIDER_URL=https://mailer.example.test/send
# EMAIL_PROVIDER_API_KEY=replace-me
# EMAIL_FROM=no-reply@example.test
# OBJECT_STORAGE_ENABLED=false
# Development-only safe adapter. Production uses the HTTPS webhook adapter.
EMAIL_VERIFICATION_PROVIDER=console
# Required in production when EMAIL_VERIFICATION_PROVIDER=webhook.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
