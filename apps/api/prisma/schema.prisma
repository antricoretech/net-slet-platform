// Sprint 0 model starter. NOT the final domain model. No official patterns seeded.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ExamFamilyCode {
  UGC_NET
  CSIR_NET
  STATE_SET_SLET
}

enum PatternStatus {
  RESEARCH_ONLY
  DISCOVERED
  RESEARCHED
  DRAFT
  SME_REVIEWED
  APPROVED
  PUBLISHED
  SUPERSEDED
  REJECTED
}

enum SyllabusStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  SME_REVIEWED
  APPROVED
  PUBLISHED
  SUPERSEDED
  REJECTED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ASSERTION_REASON
  MATCHING
  ORDERING
  READING_COMPREHENSION
  DATA_INTERPRETATION
  MATHEMATICAL
}

enum QuestionVersionStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  SME_REVIEWED
  APPROVED
  PUBLISHED
  SUPERSEDED
  REJECTED
}

enum TranslationStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ReviewDecision {
  ASSIGNED
  APPROVED
  REJECTED
  RETURNED
}

enum PublicationStatus {
  ACTIVE
  SUPERSEDED
  WITHDRAWN
}

enum RightsStatus {
  OWNED
  LICENSED
  PERMISSION_GRANTED
  PUBLIC_DOMAIN
  FAIR_USE_JUSTIFIED
  RESTRICTED
  UNKNOWN
}

enum HistoricalMetadataVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum HistoricalMetadataRecordStatus {
  IMPORTED
  VALIDATED
  VERIFIED
  REJECTED
  DUPLICATE
}

enum HistoricalMetadataImportStatus {
  DRY_RUN
  VALIDATED
  COMMITTED
  PARTIAL_REJECTED
}

enum HistoricalMetadataImportRowStatus {
  ACCEPTED
  REJECTED
  DUPLICATE
}

enum ChallengeCategory {
  INCORRECT_ANSWER_KEY
  AMBIGUOUS_QUESTION
  INCORRECT_EXPLANATION
  TRANSLATION_ERROR
  OUTDATED_FACTS
  INCORRECT_SYLLABUS_MAPPING
  COPYRIGHT_PROVENANCE
  TECHNICAL_FORMATTING
}

enum ChallengeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
  DUPLICATE
  QUARANTINED
}

enum QuestionGroupType {
  READING_COMPREHENSION
  DATA_INTERPRETATION
}

enum AccountRole {
  STUDENT
  SME
  ADMIN
}

enum GovernanceApprovalType {
  RESULT_PUBLICATION
  ANSWER_KEY_CORRECTION
  RESULT_RESCORE
}

enum GovernanceApprovalStatus {
  APPROVED
  REVOKED
  SUPERSEDED
  EXPIRED
}

enum AuditEventType {
  ACCOUNT_REGISTERED
  ACCOUNT_EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  SESSION_REVOKED
  ROLE_ACCESS_DENIED
  CATALOGUE_EXAM_CREATED
  CATALOGUE_EXAM_UPDATED
  PATTERN_DRAFT_CREATED
  PATTERN_SUBMITTED_FOR_REVIEW
  PATTERN_APPROVED
  PATTERN_REJECTED
  PATTERN_PUBLISHED
  PATTERN_SUPERSEDED
  SYLLABUS_VERSION_CREATED
  SYLLABUS_TAXONOMY_UPDATED
  QUESTION_DRAFT_CREATED
  QUESTION_REVISION_CREATED
  QUESTION_DRAFT_UPDATED
  QUESTION_OPTION_UPDATED
  QUESTION_ANSWER_KEY_UPDATED
  QUESTION_EXPLANATION_UPDATED
  QUESTION_SYLLABUS_MAPPED
  QUESTION_PROVENANCE_UPDATED
  QUESTION_SUBMITTED_FOR_REVIEW
  QUESTION_REVIEW_ASSIGNED
  QUESTION_REVIEWED
  QUESTION_APPROVED
  QUESTION_REJECTED
  QUESTION_PUBLISHED
  QUESTION_SUPERSEDED
  QUESTION_CHALLENGED
  QUESTION_CHALLENGE_RESOLVED
  QUESTION_TRANSLATION_REVIEWED
  HISTORICAL_METADATA_IMPORT_DRY_RUN
  HISTORICAL_METADATA_IMPORT_COMMITTED
  HISTORICAL_METADATA_IMPORT_REJECTED
  HISTORICAL_METADATA_VERIFIED
  ATTEMPT_CREATED
  ATTEMPT_STARTED
  ANSWER_SAVED
  SESSION_SUBMITTED
  ATTEMPT_SUBMITTED
  ATTEMPT_EXPIRED
  SCORE_RUN_CREATED
  RESULT_RELEASED
  ANSWER_KEY_CORRECTION_APPROVED
  RESULT_RESCORED
}

enum JurisdictionType {
  NATIONAL
  STATE
  UNION_TERRITORY
  REGIONAL
}

enum PatternApprovalDecision {
  APPROVED
  REJECTED
}

enum DeliveryMode {
  CBT
  OMR_SIMULATION
}

enum SessionTimingPolicy {
  CONTINUOUS
  INDEPENDENT
  SEQUENTIAL_LOCKED
}

enum AnswerPolicy {
  SINGLE_SELECT
  MULTI_SELECT
  EXACT_MATCH
}

enum TestFormStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  WITHDRAWN
}

enum AttemptStatus {
  CREATED
  READY
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum AttemptSessionStatus {
  LOCKED
  READY
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum ResultReleaseStatus {
  PENDING
  PUBLISHED
}

model Examination {
  id            String                    @id @default(uuid()) @db.Uuid
  code          String                    @unique @db.VarChar(48)
  name          String                    @db.VarChar(200)
  family        ExamFamilyCode
  organizerId   String                    @db.Uuid
  organizer     ExamOrganizer             @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  cycles        ExamCycle[]
  jurisdictions ExaminationJurisdiction[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([family])
  @@index([organizerId])
}

model ExamOrganizer {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique @db.VarChar(64)
  name            String        @db.VarChar(200)
  officialWebsite String?       @db.Text
  examinations    Examination[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Jurisdiction {
  id           String                    @id @default(uuid()) @db.Uuid
  code         String                    @unique @db.VarChar(64)
  name         String                    @db.VarChar(160)
  type         JurisdictionType
  examinations ExaminationJurisdiction[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ExaminationJurisdiction {
  examinationId  String       @db.Uuid
  jurisdictionId String       @db.Uuid
  examination    Examination  @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@id([examinationId, jurisdictionId])
  @@index([jurisdictionId])
}

model ExamCycle {
  id               String               @id @default(uuid()) @db.Uuid
  examinationId    String               @db.Uuid
  examination      Examination          @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  code             String               @db.VarChar(60)
  versions         ExamPatternVersion[]
  subjects         ExamSubject[]
  syllabusVersions SyllabusVersion[]
  questions        Question[]
  historicalQuestionMetadata HistoricalQuestionMetadata[]
  questionGroups   QuestionGroup[]
  testForms        TestForm[]
  createdAt        DateTime             @default(now())

  @@unique([examinationId, code])
}

model Question {
  id          String            @id @default(uuid()) @db.Uuid
  examCycleId String            @db.Uuid
  examCycle   ExamCycle         @relation(fields: [examCycleId], references: [id], onDelete: Restrict)
  subjectCode String            @db.VarChar(80)
  createdById String            @db.Uuid
  createdBy   Account           @relation("QuestionAuthors", fields: [createdById], references: [id], onDelete: Restrict)
  versions    QuestionVersion[]
  auditEvents AuditEvent[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([examCycleId, subjectCode])
}

model QuestionVersion {
  id           String                       @id @default(uuid()) @db.Uuid
  questionId   String                       @db.Uuid
  question     Question                     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version      Int
  status       QuestionVersionStatus        @default(DRAFT)
  type         QuestionType
  languageCode String                       @default("en") @db.VarChar(20)
  prompt       Json
  groupId      String?                      @db.Uuid
  group        QuestionGroup?               @relation(fields: [groupId], references: [id], onDelete: Restrict)
  authoredById String                       @db.Uuid
  authoredBy   Account                      @relation("QuestionRevisionAuthors", fields: [authoredById], references: [id], onDelete: Restrict)
  options      QuestionOption[]
  answerKeys   QuestionAnswerKeyVersion[]
  answerKeyCorrections AnswerKeyCorrection[]
  governanceApprovals GovernanceApproval[]
  explanations QuestionExplanationVersion[]
  mappings     QuestionSyllabusMapping[]
  translations QuestionTranslation[]
  provenance   ContentProvenance[]
  licences     ContentLicence[]
  auditEvents  AuditEvent[]
  reviews      QuestionReview[]
  publication  QuestionPublication?
  historicalMetadata HistoricalQuestionMetadata?
  challenges   QuestionChallenge[]
  testFormQuestions TestFormQuestion[]
  attemptAnswers    AttemptAnswer[]
  answerEvents      AttemptAnswerEvent[]
  learningEvidence  LearningEvidence[]
  mistakeMineEntries MistakeMineEntry[]
  explanationsUsed  ResultExplanation[]
  submittedAt  DateTime?
  approvedAt   DateTime?
  publishedAt  DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@unique([questionId, version])
  @@index([status, type])
  @@index([groupId])
}

/// Authoritative, cycle-specific metadata for a historical question. A missing
/// row means the legacy record is not yet verified; no value is inferred from
/// a cycle code or question text.
model HistoricalQuestionMetadata {
  id                    String                              @id @default(uuid()) @db.Uuid
  questionVersionId     String                              @unique @db.Uuid
  questionVersion       QuestionVersion                     @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  examCycleId           String                              @db.Uuid
  examCycle             ExamCycle                           @relation(fields: [examCycleId], references: [id], onDelete: Restrict)
  examinationFamily     ExamFamilyCode
  recordStatus          HistoricalMetadataRecordStatus      @default(IMPORTED)
  authority             String                              @db.VarChar(200)
  sourceYear            Int?
  historicalCycle       String?                             @db.VarChar(80)
  session               String?                             @db.VarChar(80)
  paper                 String?                             @db.VarChar(80)
  subjectCode           String                              @db.VarChar(80)
  questionPaperReference String?                            @db.Text
  questionSequence      Int?
  languageCode          String?                             @db.VarChar(20)
  sourceReference       String?                             @db.Text
  sourceChecksum        String?                             @db.VarChar(128)
  answerKeyProvenance   String?                             @db.Text
  rightsStatus          RightsStatus                        @default(UNKNOWN)
  rightsScope           Json?
  rightsEvidenceReference String?                           @db.Text
  rightsExpiresAt       DateTime?
  rightsLicenceId       String?                             @db.Uuid
  rightsLicence         ContentLicence?                     @relation(fields: [rightsLicenceId], references: [id], onDelete: Restrict)
  metadataFingerprint   String?                             @unique @db.Char(64)
  publicationEligible   Boolean                             @default(false)
  verificationStatus    HistoricalMetadataVerificationStatus @default(UNVERIFIED)
  verifiedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt
  importRows            HistoricalMetadataImportRow[]

  @@index([examCycleId, sourceYear, session, paper, subjectCode, languageCode])
  @@index([verificationStatus, publicationEligible, rightsStatus])
}

model HistoricalMetadataImport {
  id              String                         @id @default(uuid()) @db.Uuid
  manifestHash    String                         @unique @db.Char(64)
  sourceName      String                         @db.VarChar(240)
  sourceChecksum  String                         @db.Char(64)
  format          String                         @db.VarChar(16)
  status          HistoricalMetadataImportStatus @default(DRY_RUN)
  rowCount        Int                            @default(0)
  acceptedCount   Int                            @default(0)
  rejectedCount   Int                            @default(0)
  duplicateCount  Int                            @default(0)
  createdById     String                         @db.Uuid
  createdBy       Account                        @relation("HistoricalMetadataImports", fields: [createdById], references: [id], onDelete: Restrict)
  rows            HistoricalMetadataImportRow[]
  createdAt       DateTime                       @default(now())
  committedAt     DateTime?

  @@index([createdById, createdAt])
}

model HistoricalMetadataImportRow {
  id                  String                              @id @default(uuid()) @db.Uuid
  importId            String                              @db.Uuid
  import              HistoricalMetadataImport            @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber           Int
  questionVersionId   String?                             @db.Uuid
  metadataId          String?                             @db.Uuid
  metadata            HistoricalQuestionMetadata?         @relation(fields: [metadataId], references: [id], onDelete: SetNull)
  fingerprint         String?                             @db.Char(64)
  payload             Json
  status              HistoricalMetadataImportRowStatus   @default(REJECTED)
  rejectionReasons    Json?
  createdAt           DateTime                            @default(now())

  @@unique([importId, rowNumber])
  @@index([questionVersionId])
  @@index([metadataId])
}

model QuestionOption {
  id                String          @id @default(uuid()) @db.Uuid
  questionVersionId String          @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  optionKey         String          @db.VarChar(32)
  optionText        Json
  sequence          Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([questionVersionId, optionKey])
  @@unique([questionVersionId, sequence])
}

model QuestionAnswerKeyVersion {
  id                String          @id @default(uuid()) @db.Uuid
  questionVersionId String          @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  version           Int
  correctAnswers    Json
  exactMatch        Boolean         @default(false)
  createdById       String          @db.Uuid
  createdBy         Account           @relation("AnswerKeyAuthors", fields: [createdById], references: [id], onDelete: Restrict)
  testFormQuestions TestFormQuestion[]
  originalCorrections AnswerKeyCorrection[] @relation("CorrectionOriginal")
  revisedCorrections  AnswerKeyCorrection[] @relation("CorrectionRevised")
  createdAt         DateTime           @default(now())

  @@unique([questionVersionId, version])
}

model QuestionExplanationVersion {
  id                String            @id @default(uuid()) @db.Uuid
  questionVersionId String            @db.Uuid
  questionVersion   QuestionVersion   @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  version           Int
  languageCode      String            @default("en") @db.VarChar(20)
  explanation       Json
  createdById       String            @db.Uuid
  createdBy         Account           @relation("ExplanationAuthors", fields: [createdById], references: [id], onDelete: Restrict)
  rationales        OptionRationale[]
  createdAt         DateTime          @default(now())

  @@unique([questionVersionId, version, languageCode])
}

model OptionRationale {
  id            String                     @id @default(uuid()) @db.Uuid
  explanationId String                     @db.Uuid
  explanation   QuestionExplanationVersion @relation(fields: [explanationId], references: [id], onDelete: Cascade)
  optionKey     String                     @db.VarChar(32)
  rationale     Json

  @@unique([explanationId, optionKey])
}

model QuestionGroup {
  id          String            @id @default(uuid()) @db.Uuid
  examCycleId String            @db.Uuid
  examCycle   ExamCycle         @relation(fields: [examCycleId], references: [id], onDelete: Restrict)
  subjectCode String            @db.VarChar(80)
  type        QuestionGroupType
  title       String            @db.VarChar(240)
  stimulus    Json
  questions   QuestionVersion[]
  createdById String            @db.Uuid
  createdBy   Account           @relation("QuestionGroupAuthors", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
}

model QuestionSyllabusMapping {
  id                String          @id @default(uuid()) @db.Uuid
  questionVersionId String          @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  syllabusTopicId   String          @db.Uuid
  syllabusTopic     SyllabusTopic   @relation(fields: [syllabusTopicId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())

  @@unique([questionVersionId, syllabusTopicId])
}

model QuestionTranslation {
  id                String            @id @default(uuid()) @db.Uuid
  questionVersionId String            @db.Uuid
  questionVersion   QuestionVersion   @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  languageCode      String            @db.VarChar(20)
  prompt            Json
  status            TranslationStatus @default(DRAFT)
  createdById       String            @db.Uuid
  createdBy         Account           @relation("TranslationAuthors", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById      String?           @db.Uuid
  reviewedBy        Account?          @relation("TranslationReviewers", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([questionVersionId, languageCode])
}

model ContentProvenance {
  id                String          @id @default(uuid()) @db.Uuid
  questionVersionId String          @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  sourceTitle       String          @db.VarChar(300)
  sourceUrl         String?         @db.Text
  sourceReference   String?         @db.Text
  sourceHash        String?         @db.VarChar(128)
  sourceType        String          @default("RESEARCH_REFERENCE") @db.VarChar(80)
  rightsStatus      RightsStatus    @default(UNKNOWN)
  rightsNote        String?         @db.Text
  createdById       String          @db.Uuid
  createdBy         Account         @relation("ProvenanceAuthors", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
}

model ContentLicence {
  id                String          @id @default(uuid()) @db.Uuid
  questionVersionId String          @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  licenceName       String          @db.VarChar(200)
  licenceReference  String?         @db.Text
  restrictions      String?         @db.Text
  createdById       String          @db.Uuid
  createdBy         Account         @relation("LicenceAuthors", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  historicalMetadata HistoricalQuestionMetadata[]
}

model QuestionReview {
  id                String          @id @default(uuid()) @db.Uuid
  questionVersionId String          @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  reviewerId        String          @db.Uuid
  reviewer          Account         @relation("QuestionReviewers", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision          ReviewDecision
  notes             String          @db.Text
  evidence          Json?
  createdAt         DateTime        @default(now())

  @@index([questionVersionId, createdAt])
  @@index([reviewerId, createdAt])
}

model QuestionPublication {
  id                String            @id @default(uuid()) @db.Uuid
  questionVersionId String            @unique @db.Uuid
  questionVersion   QuestionVersion   @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  publishedById     String            @db.Uuid
  publishedBy       Account           @relation("QuestionPublishers", fields: [publishedById], references: [id], onDelete: Restrict)
  status            PublicationStatus @default(ACTIVE)
  contentHash       String            @db.VarChar(128)
  snapshot          Json
  publishedAt       DateTime          @default(now())
  supersededAt      DateTime?
  withdrawnAt       DateTime?

  @@index([status, publishedAt])
}

model QuestionChallenge {
  id                String            @id @default(uuid()) @db.Uuid
  questionVersionId String            @db.Uuid
  questionVersion   QuestionVersion   @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  reporterId        String            @db.Uuid
  reporter          Account           @relation("ChallengeReporters", fields: [reporterId], references: [id], onDelete: Restrict)
  category          ChallengeCategory
  description       String            @db.Text
  status            ChallengeStatus   @default(OPEN)
  dedupeHash        String            @unique @db.Char(64)
  resolutionNotes   String?           @db.Text
  resolvedById      String?           @db.Uuid
  resolvedBy        Account?          @relation("ChallengeResolvers", fields: [resolvedById], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now())
  resolvedAt        DateTime?

  @@index([questionVersionId, status])
  @@index([reporterId, createdAt])
}

model SyllabusVersion {
  id          String         @id @default(uuid()) @db.Uuid
  examCycleId String         @db.Uuid
  examCycle   ExamCycle      @relation(fields: [examCycleId], references: [id], onDelete: Restrict)
  subjectCode String         @db.VarChar(80)
  version     Int
  title       String         @db.VarChar(240)
  status      SyllabusStatus @default(DRAFT)
  createdById String         @db.Uuid
  createdBy   Account        @relation("SyllabusAuthors", fields: [createdById], references: [id], onDelete: Restrict)
  units       SubjectUnit[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([examCycleId, subjectCode, version])
  @@index([examCycleId, subjectCode, status])
}

model SubjectUnit {
  id                String          @id @default(uuid()) @db.Uuid
  syllabusVersionId String          @db.Uuid
  syllabusVersion   SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  code              String          @db.VarChar(80)
  title             String          @db.VarChar(240)
  sequence          Int
  topics            SyllabusTopic[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([syllabusVersionId, code])
  @@index([syllabusVersionId, sequence])
}

model SyllabusTopic {
  id               String                    @id @default(uuid()) @db.Uuid
  subjectUnitId    String                    @db.Uuid
  subjectUnit      SubjectUnit               @relation(fields: [subjectUnitId], references: [id], onDelete: Cascade)
  parentId         String?                   @db.Uuid
  parent           SyllabusTopic?            @relation("SyllabusTopicHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children         SyllabusTopic[]           @relation("SyllabusTopicHierarchy")
  questionMappings QuestionSyllabusMapping[]
  code             String                    @db.VarChar(100)
  title            String                    @db.VarChar(300)
  sequence         Int
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([subjectUnitId, code])
  @@index([subjectUnitId, sequence])
  @@index([parentId])
}

model ExamPatternVersion {
  id                String                   @id @default(uuid()) @db.Uuid
  examCycleId       String                   @db.Uuid
  examCycle         ExamCycle                @relation(fields: [examCycleId], references: [id], onDelete: Restrict)
  subjectCode       String                   @default("GENERAL") @db.VarChar(80)
  version           Int
  status            PatternStatus            @default(RESEARCH_ONLY)
  sourceUrl         String?                  @db.Text
  reviewedBy        String?                  @db.VarChar(120)
  reviewedAt        DateTime?
  approvedAt        DateTime?
  publishedAt       DateTime?
  ruleHash          String?                  @db.VarChar(128)
  rules             Json
  publishedSnapshot Json?
  createdAt         DateTime                 @default(now())
  evidence          PatternEvidence?
  approvals         PatternApproval[]
  auditEvents       AuditEvent[]
  sessions          ExamSessionConfig[]
  subjectOverrides  SubjectPatternOverride[]
  languagePolicies  LanguagePolicy[]
  ruleSources       ExamRuleSource[]
  testForms         TestForm[]

  @@unique([examCycleId, subjectCode, version])
  @@index([status])
  @@index([examCycleId, subjectCode, status])
}

model PatternEvidence {
  id                    String             @id @default(uuid()) @db.Uuid
  patternVersionId      String             @unique @db.Uuid
  patternVersion        ExamPatternVersion @relation(fields: [patternVersionId], references: [id], onDelete: Cascade)
  officialSourceUrl     String             @db.Text
  sourceDocumentHash    String             @db.VarChar(128)
  retrievedAt           DateTime           @default(now())
  sourcePublishedAt     DateTime?
  effectiveAt           DateTime?
  officialDocumentTitle String             @default("") @db.VarChar(300)
  issuingAuthority      String             @default("") @db.VarChar(240)
  evidenceExcerpt       String             @default("") @db.Text
  artifactReference     String?            @db.Text
  questionBankCoverage  Json?
  regressionReportId    String             @db.VarChar(160)
  submittedById         String             @db.Uuid
  submittedBy           Account            @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  createdAt             DateTime           @default(now())
}

model ExamSubject {
  id          String                   @id @default(uuid()) @db.Uuid
  examCycleId String                   @db.Uuid
  examCycle   ExamCycle                @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  code        String                   @db.VarChar(80)
  name        String                   @db.VarChar(200)
  status      PatternStatus            @default(RESEARCH_ONLY)
