  supersededByCorrections AnswerKeyCorrection[] @relation("CorrectionSupersession")
  createdAt DateTime @default(now())
  rescoreLineages ScoreRunLineage[]

  @@index([questionVersionId, createdAt])
}

model GovernanceApproval {
  id String @id @default(uuid()) @db.Uuid
  approvalReference String @unique @db.VarChar(160)
  type GovernanceApprovalType
  status GovernanceApprovalStatus @default(APPROVED)
  targetAttemptId String? @db.Uuid
