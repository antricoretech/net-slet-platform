model Attempt {
  id                  String                    @id @default(uuid()) @db.Uuid
  accountId           String                    @db.Uuid
  account             Account                   @relation("AttemptOwners", fields: [accountId], references: [id], onDelete: Restrict)
  testFormId          String                    @db.Uuid
  testForm            TestForm                  @relation(fields: [testFormId], references: [id], onDelete: Restrict)
  status              AttemptStatus             @default(CREATED)
  revision            Int                       @default(0)
  startIdempotencyKey String                    @db.VarChar(160)
  startedAt           DateTime?
  submittedAt         DateTime?
  expiredAt           DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  sessions            AttemptSession[]
  answers             AttemptAnswer[]
  answerEvents        AttemptAnswerEvent[]
  submissionEvents    AttemptSubmissionEvent[]
