  revisedRescore    ScoreRunLineage? @relation("RevisedScoreRun")

  @@unique([attemptId, runNumber])
  @@unique([attemptId, scoreRunHash])
}

model AttemptResult {
  id         String              @id @default(uuid()) @db.Uuid
  attemptId  String              @unique @db.Uuid
