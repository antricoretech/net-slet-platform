  revisedAnswerKeyVersionId String @unique @db.Uuid
  revisedAnswerKeyVersion QuestionAnswerKeyVersion @relation("CorrectionRevised", fields: [revisedAnswerKeyVersionId], references: [id], onDelete: Restrict)
