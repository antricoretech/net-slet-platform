model Account {
  id                       String                       @id @default(uuid()) @db.Uuid
  email                    String                       @unique @db.VarChar(320)
  passwordHash             String                       @db.VarChar(255)
  role                     AccountRole                  @default(STUDENT)
  emailVerifiedAt          DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  sessions                 Session[]
  auditEvents              AuditEvent[]
  submittedPatternEvidence PatternEvidence[]
  patternApprovals         PatternApproval[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  authoredSyllabi          SyllabusVersion[]            @relation("SyllabusAuthors")
  authoredQuestions        Question[]                   @relation("QuestionAuthors")
  authoredQuestionVersions QuestionVersion[]            @relation("QuestionRevisionAuthors")
  authoredAnswerKeys       QuestionAnswerKeyVersion[]   @relation("AnswerKeyAuthors")
  authoredExplanations     QuestionExplanationVersion[] @relation("ExplanationAuthors")
  authoredQuestionGroups   QuestionGroup[]              @relation("QuestionGroupAuthors")
  authoredTranslations     QuestionTranslation[]        @relation("TranslationAuthors")
  authoredProvenance       ContentProvenance[]          @relation("ProvenanceAuthors")
  authoredLicences         ContentLicence[]             @relation("LicenceAuthors")
  questionReviews          QuestionReview[]             @relation("QuestionReviewers")
  publishedQuestions       QuestionPublication[]        @relation("QuestionPublishers")
  reviewedTranslations     QuestionTranslation[]        @relation("TranslationReviewers")
  challengeReports         QuestionChallenge[]          @relation("ChallengeReporters")
  challengeResolutions     QuestionChallenge[]          @relation("ChallengeResolvers")
  createdTestForms         TestForm[]                   @relation("TestFormCreators")
  ownedAttempts            Attempt[]                    @relation("AttemptOwners")
  attemptCommands          AttemptCommand[]             @relation("AttemptCommandOwners")
  learningEvidence         LearningEvidence[]           @relation("LearningEvidenceOwners")
  mistakeMineEntries       MistakeMineEntry[]           @relation("MistakeMineOwners")
  learningTopicPerformance LearningTopicPerformance[]  @relation("LearningTopicPerformanceOwners")
  learningRecommendations  LearningRecommendation[]    @relation("LearningRecommendationOwners")
  releasedResults          AttemptResult[]             @relation("ResultReleasers")
  answerKeyCorrections     AnswerKeyCorrection[]       @relation("CorrectionAuthorizers")
  authorizedRescores       ScoreRunLineage[]            @relation("RescoreAuthorizers")
  governanceApprovals      GovernanceApproval[]         @relation("GovernanceApprovalReviewers")
  historicalMetadataImports HistoricalMetadataImport[]   @relation("HistoricalMetadataImports")
}

model Session {
