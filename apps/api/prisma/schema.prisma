  scoreRuns           ScoreRun[]
  result              AttemptResult?
  explanations        ResultExplanation[]
  learningEvidence    LearningEvidence[]
  mistakeMineEntries  MistakeMineEntry[]
  learningRecommendations LearningRecommendation[]
